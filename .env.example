# ==============================================================================
# Kelvornex Application Environment Variables Example Configuration
# Copy this file to '.env' at the project root and update values for deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# LOCAL vs DOCKER Database Configuration
# ------------------------------------------------------------------------------
# For LOCAL running without Docker:
#   Use 'localhost' for database URL, and configure your local mysql server password.
#
# For DOCKER (docker compose up):
#   Use 'db' for database hostname (e.g. spring datasource url below).
#   Docker Compose automatically injects SPRING_DATASOURCE_PASSWORD into the MySQL container.
# ------------------------------------------------------------------------------

# Backend Server Configuration
PORT=8085

# Database Configuration (MySQL)
# LOCAL: jdbc:mysql://localhost:3306/kelvronex_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DOCKER: jdbc:mysql://db:3306/kelvronex_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/kelvronex_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=Dtss@1011

# Hibernate Configuration
# Options: none, update, validate, create, create-drop
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=true

# Database Seeding Configuration
# Set to 'false' to disable seeding demo users ('student@example.com' / 'entrepreneur@example.com')
APP_DATABASE_SEED=true
# Controls whether spring.sql.init runs schema.sql. Options: always, never, embedded
SPRING_SQL_INIT_MODE=always

# CORS allowed origins (Comma separated, e.g. http://localhost:5173,https://my-app.com)
CORS_ALLOWED_ORIGINS=*

# Logging configurations
LOGGING_LEVEL_SPRING_SECURITY=DEBUG
LOGGING_LEVEL_SPRING_WEB=INFO

# Google OAuth Client ID
# Use GOOGLE_CLIENT_ID for backend, and VITE_GOOGLE_CLIENT_ID for Vite frontend build.
# Both can be specified here as the backend falls back to VITE_GOOGLE_CLIENT_ID if GOOGLE_CLIENT_ID is unset.
GOOGLE_CLIENT_ID=586504757431-c6l75kc9ol2lmvis489jt2vfbsmlt0go.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=586504757431-c6l75kc9ol2lmvis489jt2vfbsmlt0go.apps.googleusercontent.com

# SMTP Mail Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
MAIL_USERNAME=your_gmail_address_here@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

